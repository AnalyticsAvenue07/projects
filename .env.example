# Copy to `.env` and fill in values. Only `VITE_*` keys are exposed to the browser.

# Data mode: 'demo' (default, standalone offline) or 'api' (requires running backend services)
VITE_DATA_MODE=demo

# Backend / API (no trailing slash). Leave empty if you only use static data for now.
VITE_API_BASE_URL=

# Shown in UI or document title when you wire it up
VITE_APP_NAME=Analytics Avenue

# Set to `true` for extra console logging in dev (read in app code when you add it)
VITE_DEBUG=false

# Supabase — Project Settings → API (use `anon` / publishable key, never service_role in the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

#Healthscope Insights
VITE_HEALTHSCOPE_INSIGHTS_API_URL=http://127.0.0.1:8017
VITE_MARKETING_ANALYTICS_API_URL=http://127.0.0.1:8025
VITE_API_URL=

# Real Estate Price vs Property Features Analyzer
VITE_REAL_ESTATE_PRICE_VS_PROPERTY_FEATURES_API_URL=http://127.0.0.1:8010

# EV Dynamic Range Prediction & Anxiety Reduction Lab
VITE_EV_DYNAMIC_RANGE_PREDICTION_ANXIETY_REDUCTION_API_URL=http://127.0.0.1:8023

# For email service
VITE_EMAIL_SERVICE_URL=http://localhost:8000
VITE_ADMIN_EMAIL=rnd@analyticsavenue.in

